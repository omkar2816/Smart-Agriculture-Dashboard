# ==============================================================================
# Smart Agriculture Monitoring & AI Prediction Dashboard Environment Template
# Copy this file to .env.local and populate with your real project keys.
# DO NOT COMMIT .env.local TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration
# Obtain these from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous / Publishable Key (safe for browser exposure)
# NEVER put your service-role or secret key here!
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here

# Enable authentication enforcement (true/false)
# Set to false for direct dashboard access without login.
NEXT_PUBLIC_REQUIRE_AUTH=false

# ------------------------------------------------------------------------------
# 2. Server-Side AI Prediction & Explanation Provider (Gemini / OpenAI)
# Keys defined here remain strictly on the server and are NEVER exposed to the browser.
# Set AI_PROVIDER to 'gemini', 'openai', or 'none'.
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini

# Google Gemini API Key (obtain from https://aistudio.google.com/apikey)
# Used when AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (obtain from https://platform.openai.com/api-keys)
# Used when AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Specific AI Model Override
# Defaults: 'gemini-flash-lite-latest' (for Gemini) or 'gpt-4o-mini' (for OpenAI)
AI_MODEL=gemini-flash-lite-latest

# ------------------------------------------------------------------------------
# 3. AI Safety, Token Budget & Cost Controls (Server-Side Protections)
# ------------------------------------------------------------------------------
# Maximum completion tokens per AI analysis response
AI_MAX_OUTPUT_TOKENS=1200

# Cache duration in minutes for AI telemetry explanations (default: 180 min = 3 hours)
# Prevents expensive LLM API invocations on dashboard page refreshes.
AI_CACHE_TTL_MINUTES=180

# Maximum AI generation requests per user per hour (default: 6)
AI_RATE_LIMIT_PER_HOUR=6

# Global safety cap for total AI calls across all users per calendar day (default: 40)
AI_MAX_REQUESTS_PER_DAY=40

# Minimum cooldown between consecutive AI requests by the same user (in seconds)
AI_MIN_INTERVAL_SECONDS=120
